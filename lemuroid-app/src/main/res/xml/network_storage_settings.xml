<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="@string/settings_title_network_storage"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="@string/pref_key_network_storage_enabled"
            android:title="@string/network_storage_enabled"
            app:iconSpaceReserved="false"
            android:persistent="false"
            android:defaultValue="false"/>

        <Preference
            android:key="@string/pref_key_network_storage_configure"
            android:title="@string/network_storage_configure"
            android:summary="@string/network_storage_config_not_set"
            app:iconSpaceReserved="false"
            android:persistent="false"/>

        <Preference
            android:key="@string/pref_key_network_storage_test_connection"
            android:title="@string/network_storage_test_connection"
            android:summary="@string/network_storage_test_connection_summary"
            app:iconSpaceReserved="false"
            android:persistent="false"/>

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/network_storage_sync_category"
        app:iconSpaceReserved="false">

        <Preference
            android:key="@string/pref_key_network_storage_sync_enabled_hint"
            android:title="@string/network_storage_sync_enabled_hint"
            android:summary="@string/network_storage_sync_enabled_hint_summary"
            android:selectable="false"
            app:iconSpaceReserved="false"/>

        <SwitchPreferenceCompat
            android:key="@string/pref_key_network_storage_sync_enabled"
            android:title="@string/network_storage_sync_enabled"
            android:summary="@string/network_storage_sync_enabled_summary"
            android:dependency="@string/pref_key_network_storage_enabled"
            app:iconSpaceReserved="false"
            android:persistent="false"
            android:defaultValue="false"/>

        <Preference
            android:key="@string/pref_key_network_storage_sync_now"
            android:title="@string/network_storage_sync_now"
            android:summary="@string/network_storage_sync_idle"
            android:dependency="@string/pref_key_network_storage_sync_enabled"
            app:iconSpaceReserved="false"
            android:persistent="false"/>

        <Preference
            android:key="@string/pref_key_network_storage_sync_cancel"
            android:title="@string/network_storage_sync_cancel"
            app:iconSpaceReserved="false"
            android:persistent="false"
            android:visible="false"/>

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/network_storage_maintenance"
        app:iconSpaceReserved="false">

        <Preference
            android:key="@string/pref_key_network_storage_clear_cache"
            android:title="@string/network_storage_clear_cache"
            android:summary="@string/network_storage_clear_cache_summary"
            app:iconSpaceReserved="false"
            android:persistent="false"/>

    </PreferenceCategory>

</PreferenceScreen>
