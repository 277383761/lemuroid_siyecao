<?xml version="1.0" encoding="utf-8"?>
<!-- Plain framework widgets only: this dialog is also shown on Android TV, whose
     Theme.Leanback is not a Material Components theme and would crash when inflating
     TextInputLayout or Material-only text appearances. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/network_storage_config_description"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <RadioGroup
            android:id="@+id/network_protocol_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/network_protocol_smb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SMB" />

            <RadioButton
                android:id="@+id/network_protocol_ftp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FTP" />

            <RadioButton
                android:id="@+id/network_protocol_webdav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WebDAV" />
        </RadioGroup>

        <EditText
            android:id="@+id/network_host_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/network_storage_host"
            android:imeOptions="actionNext"
            android:inputType="textUri"
            android:maxLines="1"
            android:nextFocusForward="@id/network_port_input"
            android:singleLine="true" />

        <TextView
            android:id="@+id/network_host_helper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/network_storage_host_helper"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <TextView
            android:id="@+id/network_host_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/network_storage_error"
            android:visibility="gone" />

        <EditText
            android:id="@+id/network_port_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/network_storage_port"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:maxLines="1"
            android:nextFocusForward="@id/network_username_input"
            android:singleLine="true" />

        <TextView
            android:id="@+id/network_port_helper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/network_storage_port_helper"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <TextView
            android:id="@+id/network_port_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/network_storage_error"
            android:visibility="gone" />

        <EditText
            android:id="@+id/network_username_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/network_storage_username"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:maxLines="1"
            android:nextFocusForward="@id/network_password_input"
            android:singleLine="true" />

        <EditText
            android:id="@+id/network_password_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/network_storage_password"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:maxLines="1"
            android:nextFocusForward="@id/network_remote_path_input"
            android:singleLine="true" />

        <EditText
            android:id="@+id/network_remote_path_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/network_storage_remote_path"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:maxLines="1"
            android:singleLine="true" />

        <TextView
            android:id="@+id/network_remote_path_helper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/network_storage_remote_path_helper"
            android:textAppearance="?android:attr/textAppearanceSmall" />
    </LinearLayout>
</ScrollView>
